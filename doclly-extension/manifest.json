{
  "manifest_version": 3,
  "name": "Doclly - 25+ Free PDF & Document Tools",
  "short_name": "Doclly",
  "version": "1.0.0",
  "description": "Every tool you need to work with PDFs and Documents online. Compress, Merge, Split, Protect, Rotate, Convert & Edit with 100% offline in-extension privacy.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Doclly PDF Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://www.doclly.online/*",
    "https://student.doclly.online/*"
  ]
}
